NODE_ENV=production
PORT=
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# MongoDB database name; defaults to mainpage when unset.
MONGODB_DATABASE=mainpage
# Dangerous: enables startup index changes and data migrations, including attendance cleanup.
# Do not enable in production until the database owner reviews the migration plan and backup.
RUN_STARTUP_MIGRATIONS=false
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=<app-name>
CORS_ORIGINS=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
