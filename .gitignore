# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Android signing keys (keep keystore and properties out of version control)
/android/key/**

# Node.js dependencies
# Ignore node_modules at any level
node_modules/
**/node_modules/

# Common build outputs
# Ignore build directories at any level
build/
**/build/

# Android build outputs
/android/build/
/android/**/build/
/android/app/build/

# Backend node modules and dist
/backend/node_modules/
/backend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
